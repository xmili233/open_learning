{
  "name": "open-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A live teaching canvas operated by Codex during voice learning.",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "mcp": "node plugins/open-learning/mcp/server.js",
    "build:mcp": "esbuild plugins/open-learning/mcp/server.js --bundle --platform=node --format=esm --target=node22 --outfile=plugins/open-learning/mcp/server.bundle.js",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run build:mcp && npm run typecheck && npm run build:renderer && node --check src/board-state.js && node --check src/local-ipc.js && node --check src/electron/main.js && node --check plugins/open-learning/mcp/server.bundle.js && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
